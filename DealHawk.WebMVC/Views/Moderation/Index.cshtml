@model IEnumerable<DealHawk.Application.DTOs.ReviewDto>
@{
    ViewData["Title"] = "Review Moderation Queue";
}

<div class="pt-4">
    <div class="mb-4">
        <h2 class="fw-bold m-0"><i class="fa-solid fa-shield-halved text-cyan me-2"></i>Moderation Hub</h2>
        <p class="text-secondary m-0">Review pending user comments and ratings before publishing them</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card-custom text-center py-5">
            <i class="fa-solid fa-circle-check text-emerald mb-3" style="font-size: 3.5rem;"></i>
            <h4>All Caught Up!</h4>
            <p class="text-secondary mb-0">There are no pending reviews in the moderation queue currently.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var review in Model)
            {
                <div class="col-12">
                    <div class="card-custom text-start">
                        <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap">
                            <div>
                                <h5 class="fw-bold mb-1">
                                    Review for <span class="text-cyan">@review.GameTitle</span>
                                </h5>
                                <p class="text-secondary m-0" style="font-size: 0.9rem;">
                                    Submitted by <strong>@review.Username</strong> on @review.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </p>
                            </div>
                            <div class="star-rating" style="font-size: 1.15rem;">
                                @for (int i = 0; i < 5; i++)
                                {
                                    if (i < review.Rating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star"></i>
                                    }
                                }
                            </div>
                        </div>

                        <div class="p-3 bg-dark rounded mb-4" style="border: 1px solid var(--border-color); font-style: italic;">
                            "@review.Comment"
                        </div>

                        <form id="modForm-@review.Id" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                            <input type="hidden" name="reviewId" value="@review.Id"/>
                            <div class="flex-grow-1" style="min-width: 250px;">
                                <input type="text" name="notes" class="form-control form-control-custom py-1" placeholder="Optional notes for the reviewer..."/>
                            </div>
                            <button type="submit" asp-action="Approve" class="btn btn-primary-custom py-1 px-4">
                                <i class="fa-solid fa-circle-check me-2"></i>Approve
                            </button>
                            <button type="submit" asp-action="Reject" class="btn btn-danger py-1 px-4">
                                <i class="fa-solid fa-circle-xmark me-2"></i>Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
