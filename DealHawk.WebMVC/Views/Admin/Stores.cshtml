@model IEnumerable<DealHawk.Application.DTOs.StoreAdminDto>
@{
    ViewData["Title"] = "Admin - Stores";
}

<div class="pt-4">
    <div class="mb-4">
        <h2 class="fw-bold m-0"><i class="fa-solid fa-store text-info me-2"></i>Stores Configuration</h2>
        <p class="text-secondary m-0">Monitor store integrations mapped to CheapShark API identifiers</p>
    </div>

    <div class="row">

        <div class="col-lg-3 mb-4">
            <partial name="_AdminSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="card-custom h-auto">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold m-0"><i class="fa-solid fa-shop text-cyan me-2"></i>Connected Retailers</h4>
                    <span class="badge bg-dark border border-secondary text-cyan px-3 py-2">@Model.Count() stores configured</span>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="fa-solid fa-store-slash mb-3" style="font-size: 3rem;"></i>
                        <p class="m-0">No stores found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>Store</th>
                                    <th>CheapShark ID</th>
                                    <th>Status</th>
                                    <th>Deals Monitored</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@s.LogoUrl"
                                                     alt="@s.Name"
                                                     class="img-fluid rounded me-3"
                                                     style="width: 32px; height: 32px; object-fit: contain; background-color: rgba(255,255,255,0.02); padding: 2px; border: 1px solid var(--border-color);" />
                                                <strong class="text-light">@s.Name</strong>
                                            </div>
                                        </td>
                                        <td><code class="text-cyan">@s.CheapSharkStoreId</code></td>
                                        <td>
                                            @if (s.IsActive)
                                            {
                                                <span class="badge bg-success-subtle border border-success text-success px-3 py-2">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle border border-danger text-danger px-3 py-2">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary text-cyan px-3 py-2">
                                                <i class="fa-solid fa-tags me-2" style="font-size: 0.8rem;"></i>@s.GameCount catalog deals
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
