@model IEnumerable<DealHawk.Application.DTOs.GenreAdminDto>
@{
    ViewData["Title"] = "Admin - Genres";
}

<div class="pt-4">
    <div class="mb-4">
        <h2 class="fw-bold m-0"><i class="fa-solid fa-tags text-warning me-2"></i>Genre Catalog</h2>
        <p class="text-secondary m-0">View all classifications genres in the catalog and their catalog associations</p>
    </div>

    <div class="row">

        <div class="col-lg-3 mb-4">
            <partial name="_AdminSidebar" />
        </div>

        <div class="col-lg-9">
            <div class="card-custom h-auto">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold m-0"><i class="fa-solid fa-tag text-cyan me-2"></i>Genres List</h4>
                    <span class="badge bg-dark border border-secondary text-cyan px-3 py-2">@Model.Count() distinct genres</span>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-secondary">
                        <i class="fa-solid fa-tags mb-3" style="font-size: 3rem;"></i>
                        <p class="m-0">No genres found.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-custom">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Genre Name</th>
                                    <th>Game Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model)
                                {
                                    <tr>
                                        <td><code class="text-secondary">#@g.Id</code></td>
                                        <td><strong class="text-light">@g.Name</strong></td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary text-cyan px-3 py-2">
                                                <i class="fa-solid fa-gamepad me-2" style="font-size: 0.8rem;"></i>@g.GameCount games linked
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
