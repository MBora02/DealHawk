@model DealHawk.Application.DTOs.PaginatedListDto<DealHawk.Application.DTOs.GameDto>
@{
    ViewData["Title"] = "Game Deals Catalog";
}

<div class="row pt-4">

    <div class="col-lg-3 mb-4">
        <div class="card-custom">
            <h4 class="fw-bold mb-4"><i class="fa-solid fa-filter text-cyan me-2"></i>Filter Catalog</h4>

            <form asp-controller="Games" asp-action="Index" method="get">

                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold">Search title</label>
                    <div class="input-group">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-custom" placeholder="Type title..."/>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold">Genre</label>
                    <select name="genre" class="form-select form-control-custom">
                        <option value="">All Genres</option>
                        @foreach (var genre in new[] { "Action", "RPG", "Adventure", "Strategy", "Shooter", "Indie" })
                        {

                            if (ViewBag.Genre == genre)
                            {
                                <option value="@genre" selected="selected">@genre</option>
                            }
                            else
                            {
                                <option value="@genre">@genre</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary fw-semibold">Platform</label>
                    <select name="platform" class="form-select form-control-custom">
                        <option value="">All Platforms</option>
                        @foreach (var platform in new[] { "PC", "PlayStation", "Xbox", "Nintendo Switch" })
                        {

                            if (ViewBag.Platform == platform)
                            {
                                <option value="@platform" selected="selected">@platform</option>
                            }
                            else
                            {
                                <option value="@platform">@platform</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="fa-solid fa-circle-check me-2"></i>Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-custom btn-sm">
                        <i class="fa-solid fa-arrow-rotate-left me-2"></i>Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold m-0">Games Directory</h2>
                <p class="text-secondary m-0">Found @Model.TotalCount games matching filters</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <button type="button" class="btn btn-secondary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="fa-solid fa-download text-cyan me-1"></i>Import Games
                </button>
            }
        </div>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="card-custom text-center py-5">
                <i class="fa-solid fa-gamepad text-secondary mb-3" style="font-size: 3rem;"></i>
                <h4>No games match your search filters</h4>
                <p class="text-secondary mb-4">Try clearing filters or search for another term.</p>
                <a asp-action="Index" class="btn btn-secondary-custom btn-sm">
                    Show All Games
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var game in Model.Items)
                {
                     var lowestDeal = game.CurrentPrices.OrderBy(p => p.Price).FirstOrDefault();
                     var initialImgUrl = !string.IsNullOrEmpty(game.SteamAppId) && game.SteamAppId != "0" && !string.Equals(game.SteamAppId, "null", StringComparison.OrdinalIgnoreCase)
                         ? $"https://cdn.akamai.steamstatic.com/steam/apps/{game.SteamAppId}/library_600x900.jpg"
                         : (string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl);
                     <div class="col-sm-6 col-md-4">
                         <div class="game-card h-100 d-flex flex-column">
                             <div class="game-img-container">
                                 <div class="game-img-blur-bg" style="background-image: url('@initialImgUrl');"></div>
                                 @if (lowestDeal != null && lowestDeal.SavingsPercent > 0)
                                 {
                                     <span class="game-badge">-@((int)lowestDeal.SavingsPercent)% OFF</span>
                                 }
                                 <img src="@initialImgUrl" onerror="handleImageError(this, '@game.SteamAppId', '@(string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl)')" class="game-img" alt="@game.Title"/>
                             </div>
                            <div class="game-body d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <h3 class="game-title" title="@game.Title">@game.Title</h3>
                                    <p class="game-meta">
                                        <span class="badge bg-secondary">@game.PublisherName</span>
                                        <span class="ms-1 badge bg-dark text-cyan">@(game.Genres.FirstOrDefault() ?? "Game")</span>
                                    </p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    @if (lowestDeal != null)
                                    {
                                        <div>
                                            <span class="game-price-tag">$@lowestDeal.Price.ToString("F2")</span>
                                            @if (lowestDeal.RetailPrice > lowestDeal.Price)
                                            {
                                                <span class="game-old-price">$@lowestDeal.RetailPrice.ToString("F2")</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.9rem;">No active deals</span>
                                    }

                                    <a asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary-custom btn-sm py-1 px-3">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link-custom" asp-action="Index"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-genre="@ViewBag.Genre"
                                   asp-route-platform="@ViewBag.Platform"
                                   asp-route-page="@(Model.PageNumber - 1)">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link-custom"><i class="fa-solid fa-chevron-left"></i></span>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <li class="page-item active">
                                    <span class="page-link page-link-custom text-dark fw-bold">@i</span>
                                </li>
                            }
                            else if (i <= 3 || i >= Model.TotalPages - 2 || Math.Abs(i - Model.PageNumber) <= 1)
                            {
                                <li class="page-item">
                                    <a class="page-link page-link-custom" asp-action="Index"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-genre="@ViewBag.Genre"
                                       asp-route-platform="@ViewBag.Platform"
                                       asp-route-page="@i">@i</a>
                                </li>
                            }
                            else if (i == 4 || i == Model.TotalPages - 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link page-link-custom">...</span>
                                </li>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link page-link-custom" asp-action="Index"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-genre="@ViewBag.Genre"
                                   asp-route-platform="@ViewBag.Platform"
                                   asp-route-page="@(Model.PageNumber + 1)">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link page-link-custom"><i class="fa-solid fa-chevron-right"></i></span>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@if (User.IsInRole("Admin"))
{

    <div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-secondary text-light border border-secondary">
                <div class="modal-header border-bottom border-dark">
                    <h5 class="modal-title fw-bold" id="importModalLabel"><i class="fa-solid fa-cloud-arrow-down text-cyan me-2"></i>Import Game from CheapShark</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Admin" asp-action="ImportGames" method="post">
                    <div class="modal-body">
                        <p class="text-secondary">Enter a keyword or specific title. The system will search CheapShark and fetch matching game catalogs, active prices, and store deals in one click.</p>
                        <div class="mb-3">
                            <label class="form-label">Game Title keyword</label>
                            <input type="text" name="title" class="form-control form-control-custom" placeholder="e.g. Cyberpunk" required="required"/>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-dark">
                        <button type="button" class="btn btn-secondary-custom btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-custom">Execute Import</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
