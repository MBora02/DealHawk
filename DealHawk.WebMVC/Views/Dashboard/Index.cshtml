@{
    ViewData["Title"] = "User Dashboard";
    var favorites = ViewBag.Favorites as List<DealHawk.Application.DTOs.GameDto> ?? new List<DealHawk.Application.DTOs.GameDto>();
    var wishlist = ViewBag.Wishlist as List<DealHawk.Application.DTOs.GameDto> ?? new List<DealHawk.Application.DTOs.GameDto>();
    var alerts = ViewBag.Alerts as List<DealHawk.Application.DTOs.PriceAlertDto> ?? new List<DealHawk.Application.DTOs.PriceAlertDto>();
    var notifications = ViewBag.Notifications as List<DealHawk.Application.DTOs.NotificationDto> ?? new List<DealHawk.Application.DTOs.NotificationDto>();
    var unreadNotifCount = notifications.Count(n => !n.IsRead);
}

<div class="pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="fa-solid fa-gauge-high text-cyan me-2"></i>My Dashboard</h2>
            <p class="text-secondary m-0">Manage your watchlists, alerts, and system notifications</p>
        </div>
    </div>

    <ul class="nav nav-tabs nav-tabs-custom" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="favorites-tab" data-bs-toggle="tab" data-bs-target="#favorites" type="button" role="tab" aria-controls="favorites" aria-selected="true">
                <i class="fa-solid fa-heart me-2 text-rose"></i>Favorites (@favorites.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist" type="button" role="tab" aria-controls="wishlist" aria-selected="false">
                <i class="fa-solid fa-bookmark me-2 text-cyan"></i>Wishlist (@wishlist.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="alerts-tab" data-bs-toggle="tab" data-bs-target="#alerts" type="button" role="tab" aria-controls="alerts" aria-selected="false">
                <i class="fa-solid fa-bell me-2 text-warning"></i>Price Alerts (@alerts.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="notifications-tab" data-bs-toggle="tab" data-bs-target="#notifications" type="button" role="tab" aria-controls="notifications" aria-selected="false">
                <i class="fa-solid fa-envelope-open-text me-2 text-purple"></i>Notifications
                @if (unreadNotifCount > 0)
                {
                    <span class="badge bg-danger ms-1">@unreadNotifCount</span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content" id="dashboardTabsContent">

        <div class="tab-pane fade show active" id="favorites" role="tabpanel" aria-labelledby="favorites-tab">
            @if (!favorites.Any())
            {
                <div class="card-custom text-center py-5">
                    <i class="fa-solid fa-heart-broken text-secondary mb-3" style="font-size: 3rem;"></i>
                    <h4>Your Favorites is empty</h4>
                    <p class="text-secondary mb-4">Go to catalog and favorite games for quick pricing checks.</p>
                    <a asp-controller="Games" asp-action="Index" class="btn btn-primary-custom">Browse Games</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var game in favorites)
                    {
                        var lowestDeal = game.CurrentPrices.OrderBy(p => p.Price).FirstOrDefault();
                        var initialImgUrl = !string.IsNullOrEmpty(game.SteamAppId) && game.SteamAppId != "0" && !string.Equals(game.SteamAppId, "null", StringComparison.OrdinalIgnoreCase)
                            ? $"https://cdn.akamai.steamstatic.com/steam/apps/{game.SteamAppId}/library_600x900.jpg"
                            : (string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl);
                        <div class="col-sm-6 col-lg-3">
                            <div class="game-card h-100 d-flex flex-column">
                                <div class="game-img-container">
                                    <div class="game-img-blur-bg" style="background-image: url('@initialImgUrl');"></div>
                                    <form asp-action="ToggleFavorite" method="post" style="position: absolute; top: 12px; left: 12px; z-index: 10;">
                                        <input type="hidden" name="gameId" value="@game.Id"/>
                                        <button type="submit" class="btn btn-sm btn-dark text-rose rounded-circle border-0 shadow-lg" style="width: 32px; height: 32px; padding:0;">
                                            <i class="fa-solid fa-heart"></i>
                                        </button>
                                    </form>
                                    @if (lowestDeal != null && lowestDeal.SavingsPercent > 0)
                                    {
                                        <span class="game-badge">-@((int)lowestDeal.SavingsPercent)% OFF</span>
                                    }
                                    <img src="@initialImgUrl" onerror="handleImageError(this, '@game.SteamAppId', '@(string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl)')" class="game-img" alt="@game.Title"/>
                                </div>
                                <div class="game-body d-flex flex-column flex-grow-1 justify-content-between">
                                    <div>
                                        <h3 class="game-title" title="@game.Title">@game.Title</h3>
                                        <p class="game-meta">
                                            <span class="badge bg-secondary">@game.PublisherName</span>
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        @if (lowestDeal != null)
                                        {
                                            <div>
                                                <span class="game-price-tag">$@lowestDeal.Price.ToString("F2")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary" style="font-size: 0.9rem;">No active deals</span>
                                        }
                                        <a asp-controller="Games" asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary-custom btn-sm py-1 px-3">Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="wishlist" role="tabpanel" aria-labelledby="wishlist-tab">
            @if (!wishlist.Any())
            {
                <div class="card-custom text-center py-5">
                    <i class="fa-solid fa-bookmark text-secondary mb-3" style="font-size: 3rem;"></i>
                    <h4>Your Wishlist is empty</h4>
                    <p class="text-secondary mb-4">Save games to your wishlist to build custom alert patterns.</p>
                    <a asp-controller="Games" asp-action="Index" class="btn btn-primary-custom">Browse Games</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var game in wishlist)
                    {
                        var lowestDeal = game.CurrentPrices.OrderBy(p => p.Price).FirstOrDefault();
                        var initialImgUrl = !string.IsNullOrEmpty(game.SteamAppId) && game.SteamAppId != "0" && !string.Equals(game.SteamAppId, "null", StringComparison.OrdinalIgnoreCase)
                            ? $"https://cdn.akamai.steamstatic.com/steam/apps/{game.SteamAppId}/library_600x900.jpg"
                            : (string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl);
                        <div class="col-sm-6 col-lg-3">
                            <div class="game-card h-100 d-flex flex-column">
                                <div class="game-img-container">
                                    <div class="game-img-blur-bg" style="background-image: url('@initialImgUrl');"></div>
                                    <form asp-action="ToggleWishlist" method="post" style="position: absolute; top: 12px; left: 12px; z-index: 10;">
                                        <input type="hidden" name="gameId" value="@game.Id"/>
                                        <button type="submit" class="btn btn-sm btn-dark text-cyan rounded-circle border-0 shadow-lg" style="width: 32px; height: 32px; padding:0;">
                                            <i class="fa-solid fa-bookmark"></i>
                                        </button>
                                    </form>
                                    @if (lowestDeal != null && lowestDeal.SavingsPercent > 0)
                                    {
                                        <span class="game-badge">-@((int)lowestDeal.SavingsPercent)% OFF</span>
                                    }
                                    <img src="@initialImgUrl" onerror="handleImageError(this, '@game.SteamAppId', '@(string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl)')" class="game-img" alt="@game.Title"/>
                                </div>
                                <div class="game-body d-flex flex-column flex-grow-1 justify-content-between">
                                    <div>
                                        <h3 class="game-title" title="@game.Title">@game.Title</h3>
                                        <p class="game-meta">
                                            <span class="badge bg-secondary">@game.PublisherName</span>
                                        </p>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        @if (lowestDeal != null)
                                        {
                                            <div>
                                                <span class="game-price-tag">$@lowestDeal.Price.ToString("F2")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-secondary" style="font-size: 0.9rem;">No active deals</span>
                                        }
                                        <a asp-controller="Games" asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary-custom btn-sm py-1 px-3">Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="alerts" role="tabpanel" aria-labelledby="alerts-tab">
            @if (!alerts.Any())
            {
                <div class="card-custom text-center py-5">
                    <i class="fa-solid fa-bell-slash text-secondary mb-3" style="font-size: 3rem;"></i>
                    <h4>No active price alerts</h4>
                    <p class="text-secondary mb-4">Go to a game's details page and set a target price alert to receive notifications.</p>
                    <a asp-controller="Games" asp-action="Index" class="btn btn-primary-custom">Browse Games</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Game</th>
                                <th>Target Price</th>
                                <th>Current Lowest</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in alerts)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@alert.GameCoverImageUrl" onerror="this.onerror=null; this.src='@(string.IsNullOrEmpty(alert.GameThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : alert.GameThumbnailUrl)';" class="me-3 rounded" style="width: 50px; height: 30px; object-fit: cover; border: 1px solid var(--border-color);"/>
                                            <strong>@alert.GameTitle</strong>
                                        </div>
                                    </td>
                                    <td><strong class="text-warning">$@alert.TargetPrice.ToString("F2")</strong></td>
                                    <td>
                                        @if (alert.CurrentLowestPrice > 0)
                                        {
                                            <span class="text-emerald fw-semibold">$@alert.CurrentLowestPrice?.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (alert.IsTriggered)
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Triggered</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fa-solid fa-hourglass me-1"></i>Pending</span>
                                        }
                                    </td>
                                    <td>@alert.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Games" asp-action="Details" asp-route-id="@alert.GameId" class="btn btn-secondary-custom btn-sm">View Game</a>
                                            <form asp-action="DeleteAlert" method="post" onsubmit="return confirm('Are you sure you want to delete this price alert?');">
                                                <input type="hidden" name="alertId" value="@alert.Id"/>
                                                <button type="submit" class="btn btn-danger btn-sm px-3"><i class="fa-solid fa-trash-can"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="notifications" role="tabpanel" aria-labelledby="notifications-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0 text-secondary">System Announcements & Deal Triggers</h5>
                @if (unreadNotifCount > 0)
                {
                    <form asp-action="MarkRead" method="post">
                        <button type="submit" class="btn btn-secondary-custom btn-sm">
                            <i class="fa-solid fa-envelope-open me-2 text-cyan"></i>Mark all as read
                        </button>
                    </form>
                }
            </div>

            @if (!notifications.Any())
            {
                <div class="card-custom text-center py-5">
                    <i class="fa-solid fa-envelope text-secondary mb-3" style="font-size: 3rem;"></i>
                    <h4>No notifications yet</h4>
                    <p class="text-secondary mb-0">We will notify you here when price alerts match or system imports occur.</p>
                </div>
            }
            else
            {
                @foreach (var notif in notifications)
                {
                    <div class="notif-item @(!notif.IsRead ? "unread" : "")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="fw-bold mb-1">
                                    @notif.Title
                                    @if (!notif.IsRead)
                                    {
                                        <span class="notif-badge"></span>
                                    }
                                </h6>
                                <p class="text-secondary mb-0">@notif.Message</p>
                                <small class="text-muted" style="font-size: 0.75rem;">@notif.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                            </div>

                            @if (!notif.IsRead)
                            {
                                <form asp-action="MarkRead" method="post">
                                    <input type="hidden" name="notificationId" value="@notif.Id"/>
                                    <button type="submit" class="btn btn-sm btn-dark text-cyan border border-secondary px-3" style="font-size: 0.8rem;">
                                        Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const hash = window.location.hash;
            if (hash) {
                const tabTriggerEl = document.querySelector(`button[data-bs-target="${hash}"]`);
                if (tabTriggerEl) {

                    const tab = new bootstrap.Tab(tabTriggerEl);
                    tab.show();
                }
            }
        });
    </script>
}
