@model DealHawk.WebMVC.Models.HomeViewModel
@{
    ViewData["Title"] = "Compare Game Prices & Hunt Deals";
}

<div class="row align-items-center py-5">
    <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
        <h1 class="display-3 fw-bold mb-3" style="letter-spacing: -2px; line-height: 1.1;">
            Find the Best <br/>
            <span style="background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Game Deals</span>
        </h1>
        <p class="lead text-secondary mb-4" style="font-size: 1.25rem;">
            DealHawk aggregates pricing data across Steam, Epic Games, GOG, and Humble Bundle in real time. Track price histories, configure alerts, and buy at the historical lowest.
        </p>

        <form asp-controller="Games" asp-action="Index" method="get" class="d-flex p-1 bg-secondary rounded-pill border border-secondary" style="max-width: 500px;">
            <input type="text" name="search" class="form-control border-0 bg-transparent text-white px-4 rounded-pill" placeholder="Search games (e.g. Elden Ring)..." style="box-shadow: none;"/>
            <button type="submit" class="btn btn-primary-custom rounded-pill px-4">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Search
            </button>
        </form>
    </div>

    <div class="col-lg-6 text-center">
        <div class="position-relative d-inline-block">
            <div class="position-absolute top-50 start-50 translate-middle rounded-circle" style="width: 320px; height: 320px; background: radial-gradient(circle, var(--accent-purple-glow) 0%, transparent 70%); filter: blur(30px); z-index: -1;"></div>
            <i class="fa-solid fa-laptop-code text-cyan" style="font-size: 14rem; opacity: 0.15;"></i>
            <i class="fa-solid fa-bolt text-purple position-absolute" style="font-size: 5rem; top: 10px; right: -20px; text-shadow: 0 0 20px var(--accent-purple);"></i>
            <i class="fa-solid fa-percent text-cyan position-absolute" style="font-size: 4rem; bottom: 20px; left: -20px; text-shadow: 0 0 20px var(--accent-cyan-glow);"></i>
        </div>
    </div>
</div>

@if ((Model.TrendingGames == null || !Model.TrendingGames.Any()) && (Model.BestDeals == null || !Model.BestDeals.Any()))
{
    <div class="py-5">
        <div class="card-custom text-center py-5">
            <i class="fa-solid fa-circle-info text-secondary mb-3" style="font-size: 3rem;"></i>
            <h4>No games imported yet</h4>
            <p class="text-secondary mb-4">Log in as Administrator and import games from the control panel.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-primary-custom">
                    Go to Admin Portal
                </a>
            }
        </div>
    </div>
}
else
{
    @if (Model.TrendingGames != null && Model.TrendingGames.Any())
    {
        <div class="py-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold"><i class="fa-solid fa-fire me-2 text-rose"></i>Trending Game Deals</h2>
                    <p class="text-secondary mb-0">Popular titles based on user favorites and wishlists</p>
                </div>
                <a asp-controller="Games" asp-action="Index" class="btn btn-secondary-custom btn-sm">
                    View Full Catalog<i class="fa-solid fa-circle-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="row g-4">
                @foreach (var game in Model.TrendingGames)
                {
                    var lowestDeal = game.CurrentPrices.OrderBy(p => p.Price).FirstOrDefault();
                    var initialImgUrl = !string.IsNullOrEmpty(game.SteamAppId) && game.SteamAppId != "0" && !string.Equals(game.SteamAppId, "null", StringComparison.OrdinalIgnoreCase)
                        ? $"https://cdn.akamai.steamstatic.com/steam/apps/{game.SteamAppId}/library_600x900.jpg"
                        : (string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl);
                    <div class="col-sm-6 col-lg-3">
                        <div class="game-card h-100 d-flex flex-column">
                            <div class="game-img-container">
                                <div class="game-img-blur-bg" style="background-image: url('@initialImgUrl');"></div>
                                @if (lowestDeal != null && lowestDeal.SavingsPercent > 0)
                                {
                                    <span class="game-badge">-@((int)lowestDeal.SavingsPercent)% OFF</span>
                                }
                                <img src="@initialImgUrl" onerror="handleImageError(this, '@game.SteamAppId', '@(string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl)')" class="game-img" alt="@game.Title"/>
                            </div>
                            <div class="game-body d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <h3 class="game-title" title="@game.Title">@game.Title</h3>
                                    <p class="game-meta mb-3">
                                        <span class="badge bg-secondary text-light">@game.PublisherName</span>
                                        <span class="ms-1 badge bg-dark text-cyan">@(game.Genres.FirstOrDefault() ?? "Game")</span>
                                    </p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    @if (lowestDeal != null)
                                    {
                                        <div>
                                            <span class="game-price-tag">$@lowestDeal.Price.ToString("F2")</span>
                                            @if (lowestDeal.RetailPrice > lowestDeal.Price)
                                            {
                                                <span class="game-old-price">$@lowestDeal.RetailPrice.ToString("F2")</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.9rem;">No active deals</span>
                                    }

                                    <a asp-controller="Games" asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary-custom btn-sm py-1 px-3">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.BestDeals != null && Model.BestDeals.Any())
    {
        <div class="py-5">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold"><i class="fa-solid fa-tags me-2 text-cyan"></i>Best Deals</h2>
                    <p class="text-secondary mb-0">Games with the highest active discount percentages</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var game in Model.BestDeals)
                {
                    var lowestDeal = game.CurrentPrices.OrderBy(p => p.Price).FirstOrDefault();
                    var initialImgUrl = !string.IsNullOrEmpty(game.SteamAppId) && game.SteamAppId != "0" && !string.Equals(game.SteamAppId, "null", StringComparison.OrdinalIgnoreCase)
                        ? $"https://cdn.akamai.steamstatic.com/steam/apps/{game.SteamAppId}/library_600x900.jpg"
                        : (string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl);
                    <div class="col-sm-6 col-lg-3">
                        <div class="game-card h-100 d-flex flex-column border-cyan-glow">
                            <div class="game-img-container">
                                <div class="game-img-blur-bg" style="background-image: url('@initialImgUrl');"></div>
                                @if (lowestDeal != null && lowestDeal.SavingsPercent > 0)
                                {
                                    <span class="game-badge bg-cyan text-dark fw-bold">-@((int)lowestDeal.SavingsPercent)% OFF</span>
                                }
                                <img src="@initialImgUrl" onerror="handleImageError(this, '@game.SteamAppId', '@(string.IsNullOrEmpty(game.ThumbnailUrl) ? "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=400&q=80" : game.ThumbnailUrl)')" class="game-img" alt="@game.Title"/>
                            </div>
                            <div class="game-body d-flex flex-column flex-grow-1 justify-content-between">
                                <div>
                                    <h3 class="game-title" title="@game.Title">@game.Title</h3>
                                    <p class="game-meta mb-3">
                                        <span class="badge bg-secondary text-light">@game.PublisherName</span>
                                        <span class="ms-1 badge bg-dark text-cyan">@(game.Genres.FirstOrDefault() ?? "Game")</span>
                                    </p>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    @if (lowestDeal != null)
                                    {
                                        <div>
                                            <span class="game-price-tag text-cyan">$@lowestDeal.Price.ToString("F2")</span>
                                            @if (lowestDeal.RetailPrice > lowestDeal.Price)
                                            {
                                                <span class="game-old-price">$@lowestDeal.RetailPrice.ToString("F2")</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary" style="font-size: 0.9rem;">No active deals</span>
                                    }

                                    <a asp-controller="Games" asp-action="Details" asp-route-id="@game.Id" class="btn btn-primary-custom btn-sm py-1 px-3">
                                        Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

